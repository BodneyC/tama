/* tama: uses theme variables throughout so it works on light and dark themes. */

PetHeader {
  dock: top;
  height: 2;
  padding: 0 1;
  background: $tama-header-background;
  color: $tama-header-text;
}

#header-top {
  height: 1;
}

#identity {
  width: 1fr;
  text-style: bold;
}

#stats {
  width: auto;
}

#header-bottom {
  height: 1;
}

#others {
  width: auto;
  color: $tama-attention;
}

#attention {
  width: 1fr;
  height: 1;
  color: $tama-attention;
  text-style: bold;
}

#attention.-holiday {
  color: $text-muted;
}

#attention.-blink-off {
  visibility: hidden;
}

PetStage {
  height: 1fr;
  align: center middle;
}

#sprite {
  width: auto;
  height: auto;
}

#overlay {
  width: auto;
  height: auto;
  margin-top: 1;
}

PetStage.lights-off {
  background: $tama-lights-off;
}

/* Faded rather than tinted, so the sprite's empty cells don't show as a darker box. */
PetStage.on-holiday > #sprite {
  opacity: 50%;
}

/* Tint the children themselves: it dims the sprite's explicit pixel colours too. */
PetStage.lights-off > Static {
  tint: $tama-lights-off 55%;
}

#too-small {
  display: none;
  height: 1fr;
  content-align: center middle;
  color: $warning;
}

MainScreen.-too-small #too-small {
  display: block;
}

MainScreen.-too-small PetHeader,
MainScreen.-too-small PetStage {
  display: none;
}

ModalScreen {
  align: center middle;
}

.dialog {
  width: auto;
  max-width: 64;
  height: auto;
  padding: 1 2;
  border: round $tama-accent;
  background: $surface;
}

.dialog > Static {
  width: auto;
}

.dialog-hint {
  color: $text-muted;
  margin-top: 1;
}

#foods {
  width: auto;
  height: auto;
}

.food {
  width: 18;
  height: auto;
}

.food > Static {
  width: 100%;
  content-align: center middle;
}

#grave, #game-pet {
  width: 100%;
  content-align: center middle;
  margin-bottom: 1;
}

.dialog-title {
  text-style: bold;
  color: $tama-accent;
  margin-bottom: 1;
}

NewPetScreen, ErrorScreen, MemorialScreen {
  align: center middle;
}

#new-pet {
  width: 44;
  height: auto;
  padding: 1 2;
  border: round $tama-accent;
  background: $surface;
}

#egg {
  width: 100%;
  content-align: center middle;
  margin-bottom: 1;
}

#species {
  width: 100%;
  content-align: center middle;
  color: $text-muted;
  margin-bottom: 1;
}

#name-error {
  height: 1;
  color: $error;
}

#games {
  width: 40;
  height: auto;
  border: none;
  padding: 0;
}

#game-area {
  width: auto;
  height: auto;
}

#board-pet {
  width: auto;
  height: auto;
  margin-right: 2;
}

#board {
  width: auto;
  height: auto;
}

PetSelectScreen {
  align: center middle;
}

/* 2 border + 29 list + 1 gap + 26 preview (the widest sprite) = 58, inside 60x20. */
#pet-select {
  width: auto;
  max-width: 60;
  height: auto;
  padding: 0;
  border: round $tama-accent;
  background: $surface;
}

#pet-select-body {
  width: auto;
  height: auto;
}

#pets {
  width: 29;
  height: auto;
  max-height: 11;
  border: none;
  padding: 0;
}

#pet-preview {
  width: 26;
  height: auto;
  margin-left: 1;
}

#preview-sprite {
  width: 100%;
  content-align: center middle;
}

#preview-detail {
  width: 100%;
  color: $text-muted;
}

#memorial-row {
  width: auto;
  height: auto;
}

#memorial {
  max-width: 100%;
}

#memorial #grave {
  width: 18;
  margin: 0 1 0 0;
}

#memorial-body {
  width: auto;
  max-width: 36;
}

#journal {
  width: 64;
  max-width: 100%;
  height: 100%;
  max-height: 32;
}

#journal-tallies {
  margin-bottom: 1;
}

#journal-scroll {
  height: 1fr;
}

/* A visit (SPEC §3.2): the host and the guest each in half the stage, named underneath. */
#visit-title {
  dock: top;
  height: 1;
  padding: 0 1;
  background: $tama-header-background;
  color: $tama-header-text;
  text-style: bold;
}

#visit-stage {
  height: 1fr;
}

.visit-half {
  width: 1fr;
  height: 100%;
  align: center middle;
}

.visit-half > PetView {
  width: auto;
  height: auto;
}

.visit-name {
  width: 100%;
  content-align: center middle;
  margin-top: 1;
}

#visitors, #whose {
  width: 48;
  height: auto;
  max-height: 9;
  border: none;
  padding: 0;
}

#whose {
  width: 24;
}

/* Two small pets beside the board: fits Four in a Row at 60 columns. */
PetVsPetScreen .dialog {
  padding: 1 1;
}

#host-pet, #guest-pet {
  width: auto;
  height: auto;
}

#host-pet {
  margin-right: 1;
}

#guest-pet {
  margin-left: 1;
}
