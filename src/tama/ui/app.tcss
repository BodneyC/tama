/* tama: uses theme variables throughout so it works on light and dark themes. */

PetHeader {
  dock: top;
  height: 2;
  padding: 0 1;
  background: $tama-header-background;
  color: $tama-header-text;
}

#header-top {
  height: 1;
}

#identity {
  width: 1fr;
  text-style: bold;
}

#stats {
  width: auto;
}

#attention {
  height: 1;
  color: $tama-attention;
  text-style: bold;
}

#attention.-holiday {
  color: $text-muted;
}

#attention.-blink-off {
  visibility: hidden;
}

PetStage {
  height: 1fr;
  align: center middle;
}

#sprite {
  width: auto;
  height: auto;
}

#overlay {
  width: auto;
  height: auto;
  margin-top: 1;
}

PetStage.lights-off {
  background: $tama-lights-off;
}

/* Faded rather than tinted, so the sprite's empty cells don't show as a darker box. */
PetStage.on-holiday > #sprite {
  opacity: 50%;
}

/* Tint the children themselves: it dims the sprite's explicit pixel colours too. */
PetStage.lights-off > Static {
  tint: $tama-lights-off 55%;
}

#too-small {
  display: none;
  height: 1fr;
  content-align: center middle;
  color: $warning;
}

MainScreen.-too-small #too-small {
  display: block;
}

MainScreen.-too-small PetHeader,
MainScreen.-too-small PetStage {
  display: none;
}

ModalScreen {
  align: center middle;
}

.dialog {
  width: auto;
  max-width: 64;
  height: auto;
  padding: 1 2;
  border: round $tama-accent;
  background: $surface;
}

.dialog > Static {
  width: auto;
}

.dialog-hint {
  color: $text-muted;
  margin-top: 1;
}

#foods {
  width: auto;
  height: auto;
}

.food {
  width: 18;
  height: auto;
}

.food > Static {
  width: 100%;
  content-align: center middle;
}

#grave, #game-pet {
  width: 100%;
  content-align: center middle;
  margin-bottom: 1;
}

.dialog-title {
  text-style: bold;
  color: $tama-accent;
  margin-bottom: 1;
}

NewPetScreen, ErrorScreen, MemorialScreen {
  align: center middle;
}

#new-pet {
  width: 44;
  height: auto;
  padding: 1 2;
  border: round $tama-accent;
  background: $surface;
}

#egg {
  width: 100%;
  content-align: center middle;
  margin-bottom: 1;
}

#species {
  width: 100%;
  content-align: center middle;
  color: $text-muted;
  margin-bottom: 1;
}

#name-error {
  height: 1;
  color: $error;
}

#games {
  width: 40;
  height: auto;
  border: none;
  padding: 0;
}

#game-area {
  width: auto;
  height: auto;
}

#board-pet {
  width: auto;
  height: auto;
  margin-right: 2;
}

#board {
  width: auto;
  height: auto;
}
